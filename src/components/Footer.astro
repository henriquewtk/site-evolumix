---
import Icon from './Icon.astro';
import { company, socials, units, formatPhone } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="on-dark border-t border-white/10 bg-ink text-white">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr] lg:gap-8">
    <div>
      <img src="/evolumix-logo-dark-bg.svg" alt="Evolumix Distribuição e Suprimentos" width="180" height="40" class="h-9 w-auto" loading="lazy" />
      <p class="mt-5 max-w-[34ch] text-[15px] leading-relaxed text-on-dark">Higiene e limpeza profissional, descartáveis, papelaria e ferragista em Goiânia e Rio Verde.</p>
    </div>

    {units.map((u) => (
      <div>
        <h2 class="text-sm font-semibold text-brand">{u.city}</h2>
        <address class="mt-3 text-[15px] leading-relaxed text-on-dark not-italic">
          {u.street}<br />{u.district}<br />
          <a href={`tel:+${u.phone}`} class="text-white hover:underline">{formatPhone(u.phone)}</a><br />
          <a href={`mailto:${u.email}`} class="break-all hover:text-white hover:underline">{u.email}</a>
        </address>
      </div>
    ))}

    <div>
      <h2 class="text-sm font-semibold text-brand">Redes e loja online</h2>
      <ul class="mt-3 grid gap-1">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" class="flex min-h-9 items-center gap-2.5 text-[15px] text-on-dark hover:text-white">
              <Icon name={s.icon} size={17} /> {s.name === 'Mercado Livre' ? 'Mercado Livre' : s.handle}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-[13px] text-white/55 sm:flex-row sm:justify-between">
      <p>{company.legalName} · CNPJ {company.cnpj}</p>
      <p>© {year} {company.name}. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
